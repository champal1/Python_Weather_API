import pgeocode
import math
import requests
import json

"""This file is to get a zip code and print out the location."""

request_url = "https://archive-api.open-meteo.com/v1/archive"


def main():
    """Ask the user for their name."""
    name = input("Please enter your name: ")
    print(f"Hi {name}, let's explore some historical temperatures.")
    menu()


def print_menu(dataset_one, dataset_two):
    """Print out the menu of options."""
    print("Main menu")
    if dataset_one is None:
        print("1 - Load dataset one")
    else:
        print(f"1 - Replace {dataset_one.loc_name}")
    if dataset_two is None:
        print("2 - Load dataset two")
    else:
        print(f"2 - Replace {dataset_two.loc_name}")

    print("3 - Compare average temperatures")
    print("4 - Dates above threshold temperatures")
    print("5 - Highest historical dates")
    print("6 - Change start and end dates for dataset one")
    print("7 - Change start and end dates for dataset two")
    print("9 - Quit")


class HistoricalTemps:
    """This class is to store the lat,lon, loc_name."""

    def __init__(self, zip_code: str, start="1950-08-13", end="2023-08-25"):
        """Store zip code, start and end numbers for the user input."""
        self._zip_code = zip_code
        self._start = start
        self._end = end
        self._lat, self._lon, self._loc_name = self.zip_to_loc_info(zip_code)
        self._temp_list = None
        self._load_temps()

    def _load_temps(self):
        parameters = {"latitude": self._lat, "longitude": self._lon,
                      "start_date": self._start,
                      "end_date": self._end, "daily": "temperature_2m_max",
                      "timezone": "America/Los_Angeles"}
        results = requests.get(request_url, params=parameters)
        json_list = results.text
        self._temp_list = self._convert_json_to_list(json_list)

    def extreme_days(self, threshold: float):
        """List comprehension of date and temp."""
        list_through = [(date, temp) for date, temp in
                        self._temp_list if temp > threshold]
        return list_through

    def average_temp(self):
        """Use a for loop to add the list and divide by the length."""
        all_temp = sum(temp for _, temp in self._temp_list)
        grab_temp = len(self._temp_list)
        return all_temp / grab_temp

    def top_x_days(self, num_days=10):
        """Return a list of tuples for highest temp."""
        highest_temp = sorted(self._temp_list, key=lambda x: x[1])[:num_days]
        return highest_temp

    @staticmethod
    def zip_to_loc_info(zip_code):
        """Get the location name, latitude and longitude."""
        geocoder = pgeocode.Nominatim('us')
        get_zip = geocoder.query_postal_code(zip_code)
        lat = get_zip['latitude']
        loc_name = get_zip['place_name']
        long = get_zip['longitude']
        if math.isnan(lat):
            raise LookupError("Not a real number")
        return lat, long, loc_name

    @staticmethod
    def _convert_json_to_list(data):
        """Get the time and max temp of the zip code."""
        data = json.loads(data)

        get_dates = data["daily"]["time"]
        get_temps = data["daily"]["temperature_2m_max"]
        collect_list = list(zip(get_dates, get_temps))
        return collect_list

    @property
    def loc_name(self):
        """To get location name."""
        return self._loc_name

    @property
    def start(self):
        """To get the start value."""
        return self._start

    @start.setter
    def start(self, new_start: str):
        not_start = self._start
        try:
            self._start = new_start
            self._load_temps()
        except LookupError:
            self._start = not_start
            raise

    @property
    def end(self):
        """This is to get the end value."""
        return self._end

    @end.setter
    def end(self, new_end: str):
        not_end = self._end
        try:
            self._end = new_end
            self._load_temps()
        except LookupError:
            self._end = not_end
            raise

    @property
    def zip_code(self):
        """This is to get the zip code."""
        return self._zip_code


def create_dataset():
    """Ask user to enter a zipcode, save the input."""
    zip_code = input("Please enter a zip code: ")
    try:
        return HistoricalTemps(zip_code)
    except LookupError:
        print("Data can not be set, try again")


def print_extreme_days(dataset: HistoricalTemps):
    """Get input and print out dates and temp."""
    if dataset is None:
        print("Please load dataset first")
        return
    while True:
        thresh_input = input("List of days above what temp? ")
        try:
            needed_thresh = float(thresh_input)
            break
        except ValueError:
            print("Please enter a valid input")
    extreme_list = dataset.extreme_days(needed_thresh)
    print(f"There are {len(extreme_list)} days above {needed_thresh} degrees")
    for date, temp in extreme_list:
        print(f"{date}: {temp}")


def print_top_five_days(dataset: HistoricalTemps):
    """Get input and print out top days."""
    if dataset is None:
        print("Please load this dataset first")
        return
    top_days = dataset.top_x_days(num_days=5)
    print(f"Following are the hottest five days in "
          f"{dataset.loc_name} on record from "
          f"1950-08-13 to 2023-08-25")
    for date, temp in top_days:
        print(f"Date {date}: {temp}")


def compare_average_temps(dataset_one: HistoricalTemps,
                          dataset_two: HistoricalTemps):
    """Dataset one and two are not None, compare the temp and location."""
    if dataset_one is not None and dataset_two is not None:
        print(f"The average max temp for {dataset_one.loc_name} "
              f"is {dataset_one.average_temp():.2f} degrees Celsius")
        print(f"The average max temp for {dataset_two.loc_name} "
              f"is {dataset_two.average_temp():.2f} degrees Celsius")
    else:
        print("Please load two data sets first.")
        return


def change_dates(dataset: HistoricalTemps):
    """Ask user for start and end date."""
    if dataset is None:
        print("Please load this dataset")
        return
    start_input = input("Please enter a start date (YYYY-MM-DD): ")
    try:
        dataset.start = start_input
    except LookupError:
        print("Not a valid start date, try again")
        return
    end_input = input("Enter a end date (YYYY-MM-DD): ")
    try:
        dataset.end = end_input
    except LookupError:
        print("Not a valid end date, try again")
        return


def menu():
    """Ask the user for input, if 1 or 2 is chosen, give the location."""
    dataset_one = None
    dataset_two = None
    pick_choice = True
    while pick_choice:
        print_menu(dataset_one, dataset_two, )
        pick_choice = input("What is your choice? ")
        match pick_choice:
            case "1":
                dataset_one = create_dataset()
            case "2":
                dataset_two = create_dataset()
            case "3":
                compare_average_temps(dataset_one, dataset_two)
            case "4":
                print_extreme_days(dataset_one)
            case "5":
                print_top_five_days(dataset_one)
            case "6":
                change_dates(dataset_one)
            case "7":
                change_dates(dataset_two)
            case "9":
                print("Goodbye! Thank you for using the database!")
                break
            case _:
                print("That's not a valid selection")
        try:
            pick_choice = int(pick_choice)
        except ValueError:
            print("Please enter a number only")
            continue


if __name__ == "__main__":
    main()
